{
  "name": "remote-dsh",
  "version": "0.4.2",
  "description": "Secure remote access for DeepSeek Harness: rdsh serve / rdsh join / rdsh hub",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rdsh": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "rdsh-gateway": "workspace:*",
    "rdsh-hub": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/"
  }
}
