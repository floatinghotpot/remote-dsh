{
  "name": "remote-dsh",
  "version": "0.19.1",
  "description": "Secure remote access for DeepSeek Harness: rdsh setup / join / serve (gateway & host)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rdsh": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "rdsh-gateway": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/bin.js', 0o755)\"",
    "prepack": "pnpm run build",
    "test": "node --test \"test/*.test.ts\""
  }
}
