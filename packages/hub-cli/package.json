{
  "name": "rdsh-hub-cli",
  "version": "0.19.0",
  "description": "Run and manage the rdsh hub server: rdsh-hub serve / user / audit / host / service",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rdsh-hub": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "rdsh-gateway": "workspace:*",
    "rdsh-hub": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "node --test \"test/*.test.ts\""
  }
}
