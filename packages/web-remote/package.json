{
  "name": "dsh-web-remote",
  "version": "0.15.0",
  "description": "Secure remote access to your agent (no public IP required, end-to-end encrypted). Two-way voice (with the WhaleLink app).",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "rdsh-gateway": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "node --test \"test/*.test.ts\""
  },
  "icon": "./icon.svg"
}
